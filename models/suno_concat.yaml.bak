schema: neta.generation.model.v1
model: suno_concat
title: Suno Concat
description: Suno clip concatenation model.
adapter:
  type: suno.tasks
  operation: concat
content:
  input: []
parameters:
  poll_interval:
    type: integer
    optional: true
    default: 5
    min: 1
    max: 60
    description: Seconds between task status checks.
  max_wait:
    type: integer
    optional: true
    default: 600
    min: 30
    max: 3600
    description: Maximum seconds to wait for task completion.
meta:
  fields:
    clip_id:
      type: string
      description: Clip id to concatenate.
    is_infill:
      type: boolean
      optional: true
      description: Whether the clip is an infill result.
